{
  "manifest_version": 3,
  "name": "BOB — Assistant Conformité & Réglementation",
  "version": "0.1.0",
  "description": "Assistant interne de conformité et règlement intérieur (Atelier Métal & Industrie du Sud SAS)",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://bob-acr-api.osc-fr1.scalingo.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ouvrir BOB Conformité"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
